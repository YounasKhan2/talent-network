generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum CandidateVisibility {
  PRIVATE
  NETWORK
  VERIFIED_RECRUITERS
}

enum CandidateDiscoverability {
  HIDDEN
  SEARCHABLE
}

enum CandidateProfileVersionStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum CandidateProfileSource {
  MANUAL
  RESUME_IMPORT
  SYSTEM
}

enum CandidateAvailabilityStatus {
  IMMEDIATE
  NOTICE_PERIOD
  OPEN_TO_OFFERS
  NOT_LOOKING
}

enum CandidateWorkMode {
  REMOTE
  HYBRID
  ONSITE
  FLEXIBLE
}

enum ResumeProcessingState {
  UPLOADING
  UPLOADED
  VALIDATING
  SCANNING
  EXTRACTING
  OCR_REQUIRED
  PARSING
  READY_FOR_REVIEW
  APPROVED
  REJECTED
  FAILED_RETRYABLE
  FAILED_TERMINAL
}

model User {
  id                  String                    @id @default(uuid()) @db.Uuid
  primaryEmail        String                    @unique
  emailVerifiedAt     DateTime?
  passwordHash        String
  status              UserStatus                @default(ACTIVE)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  sessions            Session[]
  emailVerification   EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  memberships         OrganizationMember[]
  invitationsSent     OrganizationInvitation[]  @relation("InvitationInviter")
  auditEvents         AuditEvent[]               @relation("AuditActor")
  candidate           Candidate?

  @@index([status, createdAt])
}

model Session {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  tokenHash     String   @unique
  expiresAt     DateTime
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  rotatedAt     DateTime?
  revokedAt     DateTime?
  userAgentHash String?
  ipHash        String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Organization {
  id                 String                   @id @default(uuid()) @db.Uuid
  displayName        String
  legalName          String?
  slug               String                   @unique
  primaryDomain      String?
  verificationStatus VerificationStatus       @default(UNVERIFIED)
  status             OrganizationStatus       @default(ACTIVE)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  members            OrganizationMember[]
  invitations        OrganizationInvitation[]
  auditEvents        AuditEvent[]
  outboxEvents       OutboxEvent[]

  @@index([status, createdAt])
  @@index([verificationStatus, createdAt])
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  roleKey        String
  status         MembershipStatus @default(ACTIVE)
  invitedAt      DateTime?
  joinedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status, roleKey])
}

model OrganizationInvitation {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  email           String
  roleKey         String
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  invitedByUserId String           @db.Uuid
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy       User             @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, createdAt])
  @@index([email, status])
}

model Candidate {
  id                      String                    @id @default(uuid()) @db.Uuid
  userId                  String                    @unique @db.Uuid
  visibility              CandidateVisibility       @default(PRIVATE)
  discoverability         CandidateDiscoverability  @default(HIDDEN)
  primaryLocale           String                    @default("en")
  timezone                String                    @default("UTC")
  currentProfileVersionId String?                   @unique @db.Uuid
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileVersions          CandidateProfileVersion[] @relation("CandidateProfileVersions")
  currentProfileVersion   CandidateProfileVersion?  @relation("CandidateCurrentProfile", fields: [currentProfileVersionId], references: [id], onDelete: SetNull)
  resumes                  Resume[]

  @@index([discoverability, visibility, updatedAt(sort: Desc)])
}

model CandidateProfileVersion {
  id                         String                         @id @default(uuid()) @db.Uuid
  candidateId                String                         @db.Uuid
  versionNumber              Int
  status                     CandidateProfileVersionStatus @default(DRAFT)
  source                     CandidateProfileSource        @default(MANUAL)
  headline                   String?
  summary                    String?
  availabilityStatus         CandidateAvailabilityStatus?
  availableFrom              DateTime?
  compensationCurrency       String?
  compensationMinimum        Int?
  compensationTarget         Int?
  compensationPeriod         String?
  preferredWorkModes         CandidateWorkMode[]
  preferredEmploymentTypes   String[]
  approvedAt                 DateTime?
  createdAt                  DateTime                       @default(now())
  candidate                  Candidate                      @relation("CandidateProfileVersions", fields: [candidateId], references: [id], onDelete: Cascade)
  currentForCandidate        Candidate?                     @relation("CandidateCurrentProfile")
  employments                CandidateEmployment[]
  education                  CandidateEducation[]
  skills                     CandidateSkill[]
  projects                   CandidateProject[]
  certifications             CandidateCertification[]
  languages                  CandidateLanguage[]
  links                      CandidateLink[]
  locationPreferences        CandidateLocationPreference[]
  customSections             CandidateCustomSection[]
  approvedFromResumeVersions ResumeVersion[]                @relation("ResumeApprovedProfileVersion")

  @@unique([candidateId, versionNumber])
  @@index([candidateId, createdAt(sort: Desc)])
  @@index([candidateId, status, createdAt(sort: Desc)])
}

model CandidateEmployment {
  id               String                  @id @default(uuid()) @db.Uuid
  profileVersionId String                  @db.Uuid
  companyName      String
  title            String
  employmentType   String?
  location         String?
  workMode         CandidateWorkMode?
  startDate        DateTime?
  endDate          DateTime?
  isCurrent        Boolean                 @default(false)
  summary          String?
  sortOrder        Int                     @default(0)
  createdAt        DateTime                @default(now())
  profileVersion   CandidateProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)

  @@index([profileVersionId, sortOrder])
}

model CandidateEducation {
  id               String                  @id @default(uuid()) @db.Uuid
  profileVersionId String                  @db.Uuid
  institutionName  String
  degree           String?
  fieldOfStudy     String?
  location         String?
  startDate        DateTime?
  endDate          DateTime?
  isCurrent        Boolean                 @default(false)
  description      String?
  sortOrder        Int                     @default(0)
  createdAt        DateTime                @default(now())
  profileVersion   CandidateProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)

  @@index([profileVersionId, sortOrder])
}

model CandidateSkill {
  id               String                  @id @default(uuid()) @db.Uuid
  profileVersionId String                  @db.Uuid
  name             String
  normalizedName   String
  proficiency      String?
  experienceMonths Int?
  lastUsedAt       DateTime?
  sortOrder        Int                     @default(0)
  createdAt        DateTime                @default(now())
  profileVersion   CandidateProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)

  @@unique([profileVersionId, normalizedName])
  @@index([normalizedName, profileVersionId])
  @@index([profileVersionId, sortOrder])
}

model CandidateProject {
  id               String                  @id @default(uuid()) @db.Uuid
  profileVersionId String                  @db.Uuid
  name             String
  description      String?
  role             String?
  url              String?
  repositoryUrl    String?
  startDate        DateTime?
  endDate          DateTime?
  sortOrder        Int                     @default(0)
  createdAt        DateTime                @default(now())
  profileVersion   CandidateProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)

  @@index([profileVersionId, sortOrder])
}

model CandidateCertification {
  id               String                  @id @default(uuid()) @db.Uuid
  profileVersionId String                  @db.Uuid
  name             String
  issuer           String?
  credentialId     String?
  credentialUrl    String?
  issuedAt         DateTime?
  expiresAt        DateTime?
  sortOrder        Int                     @default(0)
  createdAt        DateTime                @default(now())
  profileVersion   CandidateProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)

  @@index([profileVersionId, sortOrder])
}

model CandidateLanguage {
  id               String                  @id @default(uuid()) @db.Uuid
  profileVersionId String                  @db.Uuid
  name             String
  proficiency      String?
  sortOrder        Int                     @default(0)
  createdAt        DateTime                @default(now())
  profileVersion   CandidateProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)

  @@unique([profileVersionId, name])
  @@index([profileVersionId, sortOrder])
}

model CandidateLink {
  id               String                  @id @default(uuid()) @db.Uuid
  profileVersionId String                  @db.Uuid
  label            String
  url              String
  kind             String?
  sortOrder        Int                     @default(0)
  createdAt        DateTime                @default(now())
  profileVersion   CandidateProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)

  @@index([profileVersionId, sortOrder])
}

model CandidateLocationPreference {
  id               String                  @id @default(uuid()) @db.Uuid
  profileVersionId String                  @db.Uuid
  label            String
  countryCode      String?
  region            String?
  city              String?
  remoteOnly       Boolean                 @default(false)
  sortOrder        Int                     @default(0)
  createdAt        DateTime                @default(now())
  profileVersion   CandidateProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)

  @@index([profileVersionId, sortOrder])
  @@index([countryCode, city])
}

model CandidateCustomSection {
  id               String                       @id @default(uuid()) @db.Uuid
  profileVersionId String                       @db.Uuid
  title            String
  description      String?
  sortOrder         Int                          @default(0)
  createdAt         DateTime                     @default(now())
  profileVersion   CandidateProfileVersion      @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)
  items            CandidateCustomSectionItem[]

  @@index([profileVersionId, sortOrder])
}

model CandidateCustomSectionItem {
  id              String                 @id @default(uuid()) @db.Uuid
  customSectionId String                 @db.Uuid
  title           String
  subtitle        String?
  description     String?
  startDate       DateTime?
  endDate         DateTime?
  url             String?
  sortOrder       Int                    @default(0)
  createdAt       DateTime               @default(now())
  customSection   CandidateCustomSection @relation(fields: [customSectionId], references: [id], onDelete: Cascade)

  @@index([customSectionId, sortOrder])
}

model Resume {
  id               String          @id @default(uuid()) @db.Uuid
  candidateId      String          @db.Uuid
  title            String
  currentVersionId String?         @unique @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  candidate        Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  versions         ResumeVersion[] @relation("ResumeVersions")
  currentVersion   ResumeVersion?  @relation("ResumeCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@index([candidateId, updatedAt(sort: Desc)])
}

model ResumeVersion {
  id                        String                         @id @default(uuid()) @db.Uuid
  resumeId                  String                         @db.Uuid
  versionNumber             Int
  processingState           ResumeProcessingState          @default(UPLOADING)
  objectKey                 String                         @unique
  originalFilename          String
  mimeType                  String
  sizeBytes                 Int
  checksumSha256            String?
  processingPipelineVersion String                         @default("resume-pipeline-v1")
  failureCode               String?
  failureMetadata           Json?
  uploadedAt                DateTime?
  approvedProfileVersionId  String?                        @db.Uuid
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt
  resume                    Resume                         @relation("ResumeVersions", fields: [resumeId], references: [id], onDelete: Cascade)
  currentForResume          Resume?                        @relation("ResumeCurrentVersion")
  approvedProfileVersion    CandidateProfileVersion?       @relation("ResumeApprovedProfileVersion", fields: [approvedProfileVersionId], references: [id], onDelete: SetNull)

  @@unique([resumeId, versionNumber])
  @@index([resumeId, createdAt(sort: Desc)])
  @@index([processingState, updatedAt])
  @@index([approvedProfileVersionId])
}

model AuditEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  actorType      String
  actorId        String?       @db.Uuid
  action         String
  resourceType   String
  resourceId     String
  metadata       Json?
  occurredAt     DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([resourceType, resourceId, occurredAt(sort: Desc)])
}

model OutboxEvent {
  id             String        @id @default(uuid()) @db.Uuid
  aggregateType  String
  aggregateId    String
  organizationId String?       @db.Uuid
  eventType      String
  eventVersion   Int           @default(1)
  payload        Json
  occurredAt     DateTime      @default(now())
  publishedAt    DateTime?
  attemptCount   Int           @default(0)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([publishedAt, occurredAt])
  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([aggregateType, aggregateId, occurredAt(sort: Desc)])
}
