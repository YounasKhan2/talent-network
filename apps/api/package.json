{
  "name": "@talent-network/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --watch --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "tsx --test src/account/account-context.service.test.ts src/auth/auth.crypto.test.ts src/auth/auth.http.test.ts src/auth/auth-rate-limit.service.test.ts src/authorization/authorization.service.test.ts src/resumes/resume-processing-state.test.ts",
    "test:integration": "node --env-file=../../.env --import tsx --test src/integration/phase1.integration.test.ts",
    "test:integration:phase2": "node --env-file=../../.env --import tsx --test src/integration/phase2.integration.test.ts",
    "test:integration:phase2a": "node --env-file=../../.env --import tsx --test src/integration/phase2a-privacy-firewall.integration.test.ts",
    "test:integration:phase2b": "node --env-file=../../.env --import tsx --test src/integration/phase2b-career-editor.integration.test.ts src/integration/phase2b-version-history.integration.test.ts",
    "test:integration:phase3": "node --env-file=../../.env --import tsx --test src/integration/phase3-resume-foundation.integration.test.ts src/integration/phase3d-resume-extraction.integration.test.ts src/integration/phase3e-resume-parse.integration.test.ts",
    "test:runtime:phase3d-ocr": "node --env-file=../../.env --import tsx src/runtime/phase3d-ocr-acceptance.ts",
    "test:runtime:phase3e-parse": "node --env-file=../../.env --import tsx src/runtime/phase3e-parse-acceptance.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/s3-request-presigner": "^3.888.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@talent-network/config": "workspace:*",
    "@talent-network/contracts": "workspace:*",
    "@talent-network/database": "workspace:*",
    "@talent-network/observability": "workspace:*",
    "ioredis": "^5.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsx": "^4.20.5",
    "typescript": "catalog:"
  }
}
