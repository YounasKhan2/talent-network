{
  "name": "@talent-network/scheduler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --watch --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "pnpm --filter @talent-network/resume-parsing build && tsc -p tsconfig.json --noEmit",
    "lint": "pnpm --filter @talent-network/resume-parsing build && eslint src --max-warnings=0",
    "test": "pnpm --filter @talent-network/resume-parsing build && tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@talent-network/config": "workspace:*",
    "@talent-network/database": "workspace:*",
    "@talent-network/observability": "workspace:*",
    "@talent-network/resume-extraction": "workspace:*",
    "@talent-network/resume-parsing": "workspace:*",
    "@talent-network/resume-security": "workspace:*",
    "bullmq": "^5.58.0",
    "ioredis": "^5.7.0"
  },
  "devDependencies": {
    "tsx": "^4.20.5",
    "typescript": "catalog:"
  }
}
